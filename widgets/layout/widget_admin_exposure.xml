<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_glass_card"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPITAL EXPOSURE"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/offline_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/offline_dot_red"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Outstanding Capital -->
    <TextView
        android:id="@+id/txt_outstanding_exposure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₱0.00"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_exposure_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exposure Cap: ₱0.00"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp"
        android:layout_marginBottom="4dp" />

    <ProgressBar
        android:id="@+id/exposure_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="0"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar_horizontal" />
</LinearLayout>

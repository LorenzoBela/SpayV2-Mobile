<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_glass_card"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/img_noot_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/noot_mascot"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOOT AI"
                android:textColor="@color/widget_brand_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/offline_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/offline_dot_red"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_noot_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All systems good! Keep up your on-time repayment streak."
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>

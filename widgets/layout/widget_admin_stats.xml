<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_glass_card"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Active Clients -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE CLIENTS"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_active_clients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:background="@color/widget_divider" />

    <!-- Total Orders -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL ORDERS"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_total_orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_brand_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:background="@color/widget_divider" />

    <!-- Collection Efficiency -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EFFICIENCY"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_collection_efficiency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/widget_status_verified"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient Dynamic Glass Tint (Light/Dark via DayNight) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_glass_bg" />
        </shape>
    </item>

    <!-- 2. Refractive Specular Gradient (Top highlight) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/widget_specular_start"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>

    <!-- 3. Prismatic Micro-Border Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_stroke" />
        </shape>
    </item>
</layer-list>
